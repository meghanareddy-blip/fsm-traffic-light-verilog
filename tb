`timescale 1ns/1ps

module tb_traffic_light_controller;

    reg        clk;
    reg        rst_n;
    wire [2:0] highway_light;
    wire [2:0] side_light;

    // Instantiate Design Under Test (DUT)
    traffic_light_controller dut (
        .clk(clk),
        .rst_n(rst_n),
        .highway_light(highway_light),
        .side_light(side_light)
    );

    // Generate 100MHz clock (period = 10ns)
    always #5 clk = ~clk;

    initial begin
        // Setup waveform dump
        $dumpfile("traffic_fsm.vcd");
        $dumpvars(0, tb_traffic_light_controller);

        $monitor("Time=%0t | rst_n=%b | HW_Light(R Y G)=%b | Side_Light(R Y G)=%b", 
                 $time, rst_n, highway_light, side_light);

        // Initialize signals
        clk   = 1'b0;
        rst_n = 1'b0; // Active reset

        #20;
        rst_n = 1'b1; // Release reset

        #600; // Run simulation
        $display("Simulation Finished!");
        $finish;
    end

endmodule
